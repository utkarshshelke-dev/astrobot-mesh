# Astro.bot Multi-Agent Mesh — .env.example
# Copy to .env and fill in your values

## GCP
GOOGLE_CLOUD_PROJECT=nc-ai-chatbot
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
## Models (all use Gemini 2.5 Flash)
GEMINI_MODEL=gemini-2.5-flash
ORCHESTRATOR_MODEL=gemini-2.5-flash
PERSONA_AGENT_MODEL=gemini-2.5-flash
ECONOMIST_AGENT_MODEL=gemini-2.5-flash
PM_AGENT_MODEL=gemini-2.5-flash
SCHEDULER_AGENT_MODEL=gemini-2.5-flash
## Staging bucket for Agent Engine deployment
STAGING_BUCKET=gs://nc-ai-chatbot-adk-staging
## Firestore
FIRESTORE_DB=(default)
## BigQuery RLHF logging (Layer 4 — memory partition)
BQ_RLHF_DATASET=astrobot_rlhf
BQ_RLHF_TABLE=feedback_log
BQ_MEMORY_DATASET=astrobot_memory
## Agent Engine endpoints (set after deployment — used by Orchestrator A2A)
ORCHESTRATOR_ENDPOINT=
DATA_SCIENTIST_ENDPOINT=
PERSONA_AGGREGATOR_ENDPOINT=
ECONOMIST_ENDPOINT=
PROJECT_MANAGER_ENDPOINT=
SCHEDULER_ENDPOINT=
## Data Scientist Agent (already built — point to existing deployment)
BQ_DATA_PROJECT_ID=nc-ai-chatbot
BQ_COMPUTE_PROJECT_ID=nc-ai-chatbot
BQ_DATASET_ID=Astrobot_NPI
BQML_DATASET_ID=astrobot_bqml_models
DATASET_CONFIG_FILE=/home/utkarsh_shelke/astrobot_mesh/data_science/ad_campaign_dataset_config.json
NL2SQL_METHOD=BASELINE
CODE_INTERPRETER_EXTENSION_NAME=projects/866797370377/locations/us-central1/extensions/3688537086538809344
BQML_RAG_CORPUS_NAME='test_corpus_name'
BQML_AGENT_MODEL=gemini-2.5-flash
ROOT_AGENT_MODEL=gemini-2.5-flash
ANALYTICS_AGENT_MODEL=gemini-2.5-flash
BIGQUERY_AGENT_MODEL=gemini-2.5-flash
BASELINE_NL2SQL_MODEL=gemini-2.5-flash
CHASE_NL2SQL_MODEL=gemini-2.5-flash
ADK_ARTIFACT_SERVICE_URI=file:///home/utkarsh_shelke/astrobot_mesh/.adk/artifacts
ARTIFACT_GCS_BUCKET=gs://nc-ai-chatbot-astrobot-artifacts
DS_AGENT_URL=http://localhost:8001
PM_AGENT_URL=http://localhost:8002
PA_AGENT_URL=http://localhost:8003
GOOGLE_GENAI_AFC_MAX_REMOTE_CALLS=3
LOCATION=us-central1
DS_AGENT_ENDPOINT=https://astrobot-ds-866797370377.us-central1.run.app
PA_AGENT_ENDPOINT=https://persona-aggregator-agent-866797370377.us-central1.run.app
