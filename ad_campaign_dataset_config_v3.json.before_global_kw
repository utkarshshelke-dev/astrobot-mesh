      "use_safe_divide_for_ratios"
    ],
    "rule_definitions": {
      "blended_cpa_use_unified_cte": "For blended CPA, always use a CTE with unified channel mapping and FULL OUTER JOIN to handle Cost/Conversion duality",
      "ranking_use_unified_cte": "For 'best/worst' channel rankings, use unified channel mapping CTE",
      "channel_mix_use_unified_cte": "For peak/trough/period comparisons, use unified channel CTE",
      "volatility_use_cv_not_stddev": "Volatility = Coefficient of Variation (STDDEV/AVG), not raw STDDEV. Use compute_channel_volatility() tool.",
      "organic_efficiency_use_organic_filter": "'Organic efficiency' means % of conversions from Channel IN organic_taxonomy, NOT total_conv/spend",
      "tv_halo_use_correlation": "TV halo questions use Pearson correlation between TV spend and Search/Direct conversions",
      "forecast_aggregate_to_weekly_for_chart": "Daily forecast arrays exceed chart limits; aggregate to weekly before charting",
      "always_resolve_channel_terms_via_taxonomy": "When user mentions 'awareness', 'organic', 'paid', etc., look up the actual channel list from channel_taxonomy. Never guess.",
      "pacing_use_days_remaining_for_projections": "For 'will we hit budget?' questions, use Forecast_Total_Last_7_Days × Days_Remaining",
      "flag_status_check_first": "Before reporting pacing, check Budget_Flag column for status",
      "ignore_default_channel_unless_explicit": "GVMM_Channel='DEFAULT' is unmapped/test data; exclude unless user explicitly asks about test partners",
      "use_GVMM_Channel_not_Budget_Channel_for_grouping": "When grouping pacing data, use GVMM_Channel (normalized) not Budget_Channel (raw)",
      "active_flights_only_unless_specified": "By default filter Flag_In_Flight='In Flight'; users can override",
      "use_forecast_total_for_projections": "For end-of-flight projections use Forecast_Total or Forecast_Total_Last_7_Days",
      "always_filter_by_client": "Every query must include WHERE Client = @client_id",
      "always_use_date_range_filter": "Never scan full table; always include WHERE Date >= ...",
      "never_select_star_without_limit": "Use specific columns and LIMIT if exploratory",
      "use_safe_divide_for_ratios": "Use SAFE_DIVIDE() to prevent divide-by-zero errors"
    }
