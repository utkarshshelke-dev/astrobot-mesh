                  "metrics": [
                    "spend",
                    "impressions",
                    "clicks"
                  ],
                  "dimensions": [
                    "state"
                  ],
                  "date_flag": "MTD",
                  "sort": "spend_desc",
                  "dataset_config": "ad_campaign_dataset_config.json"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_008_utm_coverage",
      "conversation": [
        {
          "invocation_id": "inv_bq_008",
          "user_content": {
            "parts": [
              {
                "text": "What percentage of sessions in BigQuery have complete UTM coverage?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "UTM coverage (L30D): X% of sessions have all 5 UTM params. Missing: utm_medium on X campaigns, utm_content on X ad groups."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_008_a",
                "name": "audit_utm_coverage_bq",
                "args": {
                  "date_flag": "L30D",
                  "required_params": [
                    "utm_source",
                    "utm_medium",
                    "utm_campaign",
                    "utm_content",
                    "utm_term"
                  ]
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_009_dark_traffic_percentage",
      "conversation": [
        {
          "invocation_id": "inv_bq_009",
          "user_content": {
            "parts": [
              {
                "text": "What percentage of total Transactions are currently attributed to Not Defined or NA?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Dark traffic audit (L30D):\nTotal transactions: X\nAttributed to 'Not Defined' or 'NA': X (X% of total)\nTrend: dark traffic share is [growing/shrinking] MoM \u2014 from X% (last month) to X% (this month).\nTop affected channels by null attribution: [list]. Recommend UTM audit and referral traffic inspection."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq009_a",
                "name": "run_bigquery_query",
                "args": {
                  "query_type": "attribution_null_check",
                  "target": "transactions",
                  "null_values": [
                    "not_defined",
                    "na",
                    "none",
                    "(not set)"
                  ],
                  "date_flag": "L30D",
                  "include_trend": true
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_010_tracking_leakage_detection",
      "conversation": [
        {
          "invocation_id": "inv_bq_010",
          "user_content": {
            "parts": [
              {
                "text": "In months where Transactions are high but channel spend is low, can we identify which tracking parameters likely failed?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Tracking leakage scan (L12M):\nMonths with high transactions + low spend (z-score anomaly): [Month A], [Month B]\nFor each flagged month \u2014 missing/null parameter breakdown:\n\u2022 utm_source null: X% of sessions\n\u2022 utm_medium null: X% of sessions\n\u2022 gclid absent: X% of paid search sessions\nMost likely failure: [parameter]. These months likely had [redirect stripping / pixel misfires / server-side tracking gaps]."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq010_a",
                "name": "detect_spend_transaction_anomaly_months",
                "args": {
                  "date_flag": "L12M",
                  "condition": "high_transactions_low_spend",
                  "z_score_threshold": 1.5
                }
              },
              {
                "id": "tu_bq010_b",
                "name": "audit_utm_coverage_bq",
                "args": {
                  "date_flag": "ANOMALY_MONTHS",
                  "required_params": [
                    "utm_source",
                    "utm_medium",
                    "utm_campaign",
                    "gclid"
                  ]
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_011_email_direct_attribution_gap",
      "conversation": [
        {
          "invocation_id": "inv_bq_011",
          "user_content": {
            "parts": [
              {
                "text": "Is there a correlation between Email spend and Direct transactions that suggests our Email attribution is under-reporting?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Email \u2192 Direct correlation (L12M):\nPearson r between Email spend and Direct transactions: r=X.XX (p=X.XX)\nIf r is high and positive, Email sends are likely driving Direct traffic (users typing URL or using bookmarks after seeing email \u2014 not click-tracked).\nConclusion: [Strong/Weak] evidence of Email attribution under-reporting. Estimated under-attributed transactions: ~X/month based on regression residuals. Recommend implementing UTM parameters on all email CTAs and server-side open tracking."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq011_a",
                "name": "compute_channel_transaction_correlation",
                "args": {
                  "source": "email_spend",
                  "target": "direct_transactions",
                  "date_flag": "L12M",
                  "method": "pearson"
                }
              },
              {
                "id": "tu_bq011_b",
                "name": "run_bigquery_query",
                "args": {
                  "query_type": "regression_residuals",
                  "predictor": "email_spend",
                  "target": "direct_transactions",
                  "date_flag": "L12M"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    }
  ]
}