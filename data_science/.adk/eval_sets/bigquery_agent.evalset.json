{
  "eval_set_id": "bigquery_agent_eval_v1",
  "name": "BigQuery Sub-Agent (data_science/sub_agents/bigquery) Eval",
  "description": "Tests BigQuery data access: raw metric queries, dataset config adherence (ad_campaign_dataset_config.json), cross-dataset joins (cross_dataset_relations.json), data freshness, zero-data checks, and spend reconciliation.",
  "eval_cases": [
    {
      "eval_id": "bq_001_raw_metrics_query",
      "conversation": [
        {
          "invocation_id": "inv_bq_001",
          "user_content": {
            "parts": [
              {
                "text": "Pull impressions, clicks, and spend for all campaigns in L7D."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Queried BigQuery (ad_campaign_dataset_config): [table with campaign_id, impressions, clicks, spend for L7D]."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_001_a",
                "name": "run_bigquery_query",
                "args": {
                  "metrics": [
                    "impressions",
                    "clicks",
                    "spend"
                  ],
                  "dimensions": [
                    "campaign_id"
                  ],
                  "date_flag": "L7D",
                  "dataset_config": "ad_campaign_dataset_config.json"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_002_cross_dataset_roas",
      "conversation": [
        {
          "invocation_id": "inv_bq_002",
          "user_content": {
            "parts": [
              {
                "text": "Join campaign spend with revenue to compute ROAS by campaign for L30D."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Cross-dataset ROAS by campaign (L30D): [table \u2014 spend from ads dataset joined with revenue from revenue dataset per cross_dataset_relations.json]."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_002_a",
                "name": "run_cross_dataset_query",
                "args": {
                  "relations_config": "cross_dataset_relations.json",
                  "computed_metric": "ROAS",
                  "dimensions": [
                    "campaign_id"
                  ],
                  "date_flag": "L30D"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_003_data_freshness",
      "conversation": [
        {
          "invocation_id": "inv_bq_003",
          "user_content": {
            "parts": [
              {
                "text": "When was the BigQuery data last updated?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "BigQuery data freshness:\n\u2705 Google Ads table: last updated [timestamp]\n\u2705 Meta Ads table: last updated [timestamp]\n\u26a0\ufe0f DV360 table: last updated [timestamp] \u2014 Xh ago, exceeds 6h SLA"
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_003_a",
                "name": "check_table_freshness",
                "args": {
                  "tables": "all",
                  "sla_hours": 6
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_004_zero_data_check",
      "conversation": [
        {
          "invocation_id": "inv_bq_004",
          "user_content": {
            "parts": [
              {
                "text": "Are there any tables with zero rows for today?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Zero-row check for today: [N] tables returned 0 rows \u2014 [table names]. These had data yesterday. Likely pipeline lag or ingestion failure."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_004_a",
                "name": "check_zero_rows",
                "args": {
                  "date_flag": "TODAY",
                  "compare_previous_day": true
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_005_spend_reconciliation",
      "conversation": [
        {
          "invocation_id": "inv_bq_005",
          "user_content": {
            "parts": [
              {
                "text": "Does the spend in BigQuery match the platform numbers?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Spend reconciliation (L7D):\nGoogle Ads: BQ $X vs Platform $X \u2014 delta $X (X%) \u2705\nMeta: BQ $X vs Platform $X \u2014 delta $X (X%) \u26a0\ufe0f exceeds 2% tolerance"
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_005_a",
                "name": "reconcile_spend_bq_vs_platform",
                "args": {
                  "date_flag": "L7D",
                  "tolerance_pct": 2,
                  "channels": "all"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_006_campaign_filter",
      "conversation": [
        {
          "invocation_id": "inv_bq_006",
          "user_content": {
            "parts": [
              {
                "text": "Show me spend and ROAS for only Paid Search campaigns in L30D."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Paid Search campaigns (L30D): [table filtered to channel=paid_search \u2014 campaign, spend, revenue, ROAS]."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bq_006_a",
                "name": "run_bigquery_query",
                "args": {
                  "metrics": [
                    "spend",
                    "revenue",
                    "ROAS"
                  ],
                  "dimensions": [
                    "campaign_id",
                    "campaign_name"
                  ],
                  "filters": {
                    "channel": "paid_search"
                  },
                  "date_flag": "L30D",
                  "dataset_config": "ad_campaign_dataset_config.json"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "bq_007_geo_breakdown",
      "conversation": [
        {
          "invocation_id": "inv_bq_007",
          "user_content": {
            "parts": [
              {
                "text": "Pull spend by state from BigQuery for MTD."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Spend by state (MTD from BigQuery): [table with state, spend, impressions, clicks sorted by spend desc]."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
