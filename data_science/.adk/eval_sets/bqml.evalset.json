                "args": {
                  "model": "LINEAR_REG",
                  "target": "ROAS",
                  "feature": "spend",
                  "channel": "paid_search",
                  "training_window": "L90D"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
