            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Transaction forecast \u2014 next quarter (ARIMA_PLUS, trained on L12M):\nQ total: X transactions (80% CI: [X, X])\nMonth 1: X | Month 2: X | Month 3: X\nExpected trend: [upward/flat/downward] vs same quarter last year (+/-X% YoY). Key risk: forecast assumes no major campaign changes or seasonality shifts."
              }
