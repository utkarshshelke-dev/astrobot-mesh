{
  "eval_set_id": "bqml_agent_eval_v1",
  "name": "BQML Sub-Agent (data_science/sub_agents/bqml) Eval",
  "description": "Tests BigQuery ML capabilities: ARIMA_PLUS spend/revenue forecasting, linear regression for ROAS prediction, anomaly detection models, and model metadata/status queries.",
  "eval_cases": [
    {
      "eval_id": "bqml_001_spend_forecast",
      "conversation": [
        {
          "invocation_id": "inv_bqml_001",
          "user_content": {
            "parts": [
              {
                "text": "Forecast our total spend for the next 30 days."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "ARIMA_PLUS spend forecast (next 30 days): Projected spend $X with 80% confidence interval [$X, $X]. Trend: [upward/flat/downward] vs L30D actuals."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bqml_001_a",
                "name": "run_bqml_forecast",
                "args": {
                  "model": "ARIMA_PLUS",
                  "target_metric": "spend",
                  "horizon_days": 30,
                  "training_window": "L90D"
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
