      "conversation": [
        {
          "invocation_id": "inv_bqml_003",
          "user_content": {
            "parts": [
              {
                "text": "Can you predict ROAS based on spend level for Paid Search?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Linear regression (BQML) \u2014 Paid Social ROAS vs spend (L90D):\nAt $X/day spend \u2192 predicted ROAS X.Xx\nAt $X/day spend \u2192 predicted ROAS X.Xx\nModel R\u00b2: X.XX. Diminishing returns inflection at ~$X/day."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_bqml_003_a",
