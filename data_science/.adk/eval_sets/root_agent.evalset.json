          },
          "final_response": {
            "parts": [{ "text": "I can pull several views — which would you like?\n• Spend pacing vs budget\n• ROAS / CPA by channel\n• Creative performance\n• Weekly stoplight report" }],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [],
            "intermediate_responses": []
          }
        }
      ]
    },
    {
      "eval_id": "root_008_cross_dataset",
      "conversation": [
        {
          "invocation_id": "inv_root_008",
          "user_content": {
            "parts": [{ "text": "Join campaign spend with revenue data and show ROAS by campaign." }],
            "role": "user"
          },
          "final_response": {
            "parts": [{ "text": "Cross-dataset ROAS by campaign (L30D): [table using cross_dataset_relations config — spend from BigQuery joined with revenue from AlloyDB]." }],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "id": "tu_root_008_a",
                "name": "bigquery_agent",
                "args": { "query_type": "cross_dataset_join", "config": "cross_dataset_relations.json", "date_flag": "L30D" }
              }
            ],
            "intermediate_responses": []
          }
        }
      ]
    }
  ]
}