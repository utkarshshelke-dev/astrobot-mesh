# ============================================================
# ARGUMENT SIZE GUARD - prevent MALFORMED_FUNCTION_CALL
# ============================================================
import json as _json_module
_MAX_FUNCTION_ARG_SIZE = 6000


def _enforce_arg_size(arg_str):
    """If a function arg is too big, truncate or summarize it."""
    if not arg_str:
        return arg_str
    if len(arg_str) <= _MAX_FUNCTION_ARG_SIZE:
        return arg_str
    print(f"[ARG GUARD] Argument too large ({len(arg_str)} chars), truncating to {_MAX_FUNCTION_ARG_SIZE}")
    return arg_str[:_MAX_FUNCTION_ARG_SIZE] + " ... [TRUNCATED - argument was too large for Gemini]"


def _wrap_call_analytics_agent(orig_func):
    """Wrap call_analytics_agent to enforce arg size."""
    def wrapped(*args, **kwargs):
        new_args = [_enforce_arg_size(a) if isinstance(a, str) else a for a in args]
        new_kwargs = {k: (_enforce_arg_size(v) if isinstance(v, str) else v) for k, v in kwargs.items()}
        return orig_func(*new_args, **new_kwargs)
    return wrapped


