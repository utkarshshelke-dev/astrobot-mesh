        AND Date >= DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH)
      GROUP BY Date, unified_channel
    ),
    conv_unified AS (
      SELECT 
        Date,
        CASE 
          WHEN Channel IN ('Search', 'Paid Search') THEN 'Paid Search'
          WHEN Channel IN ('Cross-network', 'Demand Gen', 'Performance Max') THEN 'Demand Gen + P-Max'
          WHEN Channel IN ('Paid Social') THEN 'Paid Social'
          WHEN Channel IN ('Online Video', 'Paid Video', 'Video', 'OTT', 'CTV', 'Linear TV') THEN 'Video/CTV/OTT/TV'
          ELSE Channel
        END AS unified_channel,
        SUM(Conversions) AS daily_conv
      FROM `<project>.Astrobot_<client>.vw_astrobot_<client_lower>_nc360_dashboard`
      WHERE Conversions > 0 AND Client = '<client>'
        AND Date >= DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH)
      GROUP BY Date, unified_channel
    )
    SELECT 
      COALESCE(s.unified_channel, c.unified_channel) AS Channel_Group,
      ROUND(SUM(COALESCE(s.daily_spend, 0)), 2) AS Total_Spend,
      SUM(COALESCE(c.daily_conv, 0)) AS Total_Conversions,
      ROUND(SAFE_DIVIDE(SUM(COALESCE(c.daily_conv, 0)), NULLIF(SUM(COALESCE(s.daily_spend, 0)), 0)), 4) AS Conv_Per_Dollar
    FROM spend_unified s
    FULL OUTER JOIN conv_unified c
      ON s.Date = c.Date AND s.unified_channel = c.unified_channel
    GROUP BY Channel_Group
    HAVING Total_Spend > 100
    ORDER BY Conv_Per_Dollar ASC  -- ASC for worst, DESC for best
    
