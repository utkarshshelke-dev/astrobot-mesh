# orchestrator/agent.py
"""
Astro.bot Orchestrator — multi-agent mesh with inline chart rendering.

All ADK callbacks implemented:
  before_agent_callback  — session setup, client lock, memory load
  after_agent_callback   — response logging, RLHF tagging
  before_tool_callback   — skill matching log, input validation
  after_tool_callback    — response caching, error detection
  before_model_callback  — prompt enrichment, context injection
  after_model_callback   — token usage logging

Chart rendering: VertexAiCodeExecutor on orchestrator root agent ensures
charts generated by the analytics sub-agent surface inline in the UI session.
"""

from __future__ import annotations

import json
import logging
import os
import time
from dataclasses import asdict, dataclass, field
from datetime import date
from typing import Any, Optional

from google.adk.agents import LlmAgent
from google.adk.agents.callback_context import CallbackContext
from google.adk.code_executors import VertexAiCodeExecutor
from google.adk.tools import BaseTool, ToolContext
from google.adk.tools.agent_tool import AgentTool
from google.genai import types

from orchestrator.prompts import return_instructions_orchestrator

logger = logging.getLogger(__name__)

VALID_CLIENTS = {"NPI", "Venetian", "WinnDixie"}

_CODE_INTERPRETER = os.getenv(
    "CODE_INTERPRETER_EXTENSION_NAME",
    "projects/866797370377/locations/us-central1/extensions/3688537086538809344",
)


# ══════════════════════════════════════════════════════════════════════════════
# AGENT CARD + SKILLS
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class AgentSkill:
    id:          str
    name:        str
    description: str
    examples:    list[str] = field(default_factory=list)
    tags:        list[str] = field(default_factory=list)


@dataclass
class AgentCard:
    agent_id:     str
    name:         str
    version:      str
    description:  str
    endpoint:     str
    skills:       list[AgentSkill]
    input_schema: dict = field(default_factory=dict)
    output_mode:  str  = "markdown"

    @property
    def is_remote(self) -> bool:
        return bool(self.endpoint)

    def to_json(self) -> str:
        return json.dumps(asdict(self), indent=2)


