# ══════════════════════════════════════════════════════════════════════════════
# TOOLS
# ══════════════════════════════════════════════════════════════════════════════

async def call_data_scientist(
    query:        str,
    tool_context: ToolContext,
) -> str:
    """
    Routes analytics requests to the Data Scientist Agent.
    Uses sub_agent transfer — same session as orchestrator, charts render inline.

    Args:
        query:        Natural language analytics question or request.
        tool_context: ADK tool context (carries session state).
    """
    import os as _os
    client_id  = tool_context.state.get("client_id", "NPI")
    session_id = tool_context.state.get("session_id", "")
    endpoint   = _os.getenv("DS_AGENT_ENDPOINT", "")

    if endpoint:
        logger.info("Routing to REMOTE DS agent: %s", endpoint)
        from orchestrator.remote_client import call_remote_ds_agent
        response = await call_remote_ds_agent(
            query=query,
            client_id=client_id,
            session_id=session_id,
        )
    else:
        logger.info("Routing to LOCAL DS agent")
        from data_science.agent import root_agent as _ds
        enriched = f"[Client: {client_id}] {query}"
        _ds_tool = AgentTool(agent=_ds)
        response = await _ds_tool.run_async(
            args={"request": enriched},
            tool_context=tool_context,
        )

    tool_context.state["last_ds_response"] = response
    tool_context.state["last_ds_query"]    = query

    # Capture DS session id from remote_client
    tool_context.state["_last_ds_session_id"] = os.environ.get("_LAST_DS_SESSION_ID", "")

    # Fetch charts from CURRENT DS session only (not all of GCS)
    try:
        import time as _t
        from google.cloud import storage as _gcs
        _ds_session_id = tool_context.state.get("_last_ds_session_id", "")
        if _ds_session_id:
            _bucket_name = os.getenv("ARTIFACT_GCS_BUCKET", "nc-ai-chatbot-astrobot-artifacts").replace("gs://", "")
            _client_gcs = _gcs.Client()
            _bucket = _client_gcs.bucket(_bucket_name)
            _now = _t.time()
            _prefix = f"data_science/orchestrator/{_ds_session_id}/"
            from google.genai import types as _gt
            _seen = tool_context.state.get("_charts_forwarded", set())
            if not isinstance(_seen, set):
                _seen = set(_seen) if _seen else set()
            for _blob in _bucket.list_blobs(prefix=_prefix):
                if not (_blob.name.endswith(".png/0") or _blob.name.endswith(".png")):
                    continue
                if (_now - _blob.updated.timestamp()) > 60:
                    continue
                _fname = _blob.name.split("/")[-2] if _blob.name.endswith("/0") else _blob.name.split("/")[-1]
                if _fname in _seen:
                    continue
                _seen.add(_fname)
                _img_data = _blob.download_as_bytes()
                try:
                    _part = _gt.Part.from_bytes(data=_img_data, mime_type="image/png")
                    version = await tool_context.save_artifact(_fname, _part)
                    logger.info(f"✓ Chart saved: {_fname} v{version}")
                except Exception as _ae:
                    logger.warning(f"save_artifact failed: {_ae}")
            tool_context.state["_charts_forwarded"] = list(_seen)
    except Exception as _ce:
        logger.debug(f"Chart sync skipped: {_ce}")

    return response


async def submit_feedback(rating: int, comment: str, tool_context) -> str:
    """Submit thumbs up (rating=1) or thumbs down (rating=-1) feedback."""
    import time
    feedback = {
        "rating": rating,
        "comment": comment,
        "turn": tool_context.state.get("turn_count", 0),
        "client_id": tool_context.state.get("client_id", ""),
        "timestamp": time.time()
    }
    tool_context.state.setdefault("feedback_log", []).append(feedback)
    label = "👍 Thanks for the positive feedback!" if rating > 0 else "👎 Thanks for the feedback — we'll improve."
    return label


async def call_project_manager(
    pm_request:   str,
    tool_context: ToolContext,
) -> str:
    """
    Routes project management requests to the Project Manager Agent (§4.2).
    Use for: tasks, emails, project timelines, team correspondence.
    All operations strictly partitioned by client_id.

    Args:
        pm_request:   Natural language project management request.
        tool_context: ADK tool context.
    """
    from project_manager.agent import root_agent as _pm

    client_id = tool_context.state.get("client_id", "NPI")
    enriched  = f"[Client: {client_id}] {pm_request}"
    logger.info("Orchestrator → PM [§4.2] | client=%s | request=%s…", client_id, pm_request[:60])
    tool_context.state.setdefault("session_context", {})
    tool_context.state["session_context"]["client_id"]  = client_id
    tool_context.state["session_context"]["session_id"] = tool_context.state.get("session_id", "")
    tool_context.state["session_context"]["user_id"]    = tool_context.state.get("user_id", "")
    _pm_tool = AgentTool(agent=_pm)
    response  = await _pm_tool.run_async(
        args={"request": enriched},
        tool_context=tool_context,
    )
    tool_context.state["last_pm_response"] = response
    tool_context.state["last_pm_query"]    = pm_request
    return response


async def call_persona_aggregator(
    persona_request: str,
    tool_context:    ToolContext,
) -> str:
    """
    Routes persona analysis to the Persona Aggregator Agent (§3).
    Uses remote Cloud Run endpoint if PA_AGENT_ENDPOINT is set.

    Clients and personas:
      NPI:       HNW Luxury Seeker, DINK Couple, Legacy Family
      Venetian:  9 personas (Affluent, Group Planner, Gourmet, etc.)
      WinnDixie: Mallory, Maria, Carol, Amy
    """
    import os as _os2
    client_id = tool_context.state.get("client_id", "NPI")
    session_id = tool_context.state.get("session_id", "")
    pa_endpoint = _os2.getenv(
        "PA_AGENT_ENDPOINT",
        "https://persona-aggregator-agent-866797370377.us-central1.run.app"
    )

    logger.info("Orchestrator → PA [§3] | client=%s | request=%s…", client_id, persona_request[:60])

    if pa_endpoint:
        # Remote: call deployed Persona Aggregator on Cloud Run
        logger.info("Routing to REMOTE PA agent: %s", pa_endpoint)
        try:
            from orchestrator.remote_client import _get_token, _post
            token = _get_token()

            # Create session
            session = _post(
                f"{pa_endpoint}/apps/PersonaAgent/users/orchestrator/sessions",
                {"state": {"client_id": client_id, "LOCKED_CLIENT": client_id}},
                token
            )
            sid = session.get("id", f"pa_{client_id}")

            # Run query
            response = _post(f"{pa_endpoint}/run", {
                "app_name": "PersonaAgent",
                "user_id": "orchestrator",
                "session_id": sid,
                "new_message": {
                    "role": "user",
                    "parts": [{"text": f"[Client: {client_id}] {persona_request}"}]
                }
            }, token)

            events = response if isinstance(response, list) else [response]
            parts = []
            for event in events:
                for part in event.get("content", {}).get("parts", []):
                    if "text" in part and part["text"].strip():
                        parts.append(part["text"])
            return "\n".join(parts) or "(no response from PA agent)"

        except Exception as e:
            logger.error("Remote PA call failed: %s", e)
            return f"Persona aggregator error: {e}"
    else:
        # Local fallback
        from persona_aggregator.agent import root_agent as _pa
        enriched = f"[Client: {client_id}] {persona_request}"
        _pa_tool = AgentTool(agent=_pa)
        response = await _pa_tool.run_async(
            args={"request": enriched},
            tool_context=tool_context,
        )
        return response


async def call_economist(
    economic_request: str,
    tool_context: ToolContext,
) -> str:
    """
    Routes macroeconomic context requests to the Economist Agent.
    Use for: market benchmarks, economic indicators, industry context,
    FRED data, unemployment, CPI, consumer sentiment, Fed funds rate.

    Args:
        economic_request: Natural language economic data request.
        tool_context:     ADK tool context.
    """
    import os as _os3
    client_id  = tool_context.state.get("client_id", "NPI")
    econ_endpoint = _os3.getenv(
        "ECON_AGENT_ENDPOINT",
        "https://economist-agent-866797370377.us-central1.run.app"
    )
    logger.info("Orchestrator → Economist | client=%s | request=%s…", client_id, economic_request[:60])

    try:
        from orchestrator.remote_client import _get_token, _post
        token = _get_token()

        # Create session
        session = _post(
            f"{econ_endpoint}/apps/economist_agent_2/users/orchestrator/sessions",
            {"state": {"client_id": client_id}},
            token
        )
        sid = session.get("id", f"econ_{client_id}")

        # Run query
        response = _post(f"{econ_endpoint}/run", {
            "app_name": "economist_agent_2",
            "user_id": "orchestrator",
            "session_id": sid,
            "new_message": {
                "role": "user",
                "parts": [{"text": f"[Client: {client_id}] {economic_request}"}]
            }
        }, token)

        events = response if isinstance(response, list) else [response]
        parts = []
        for event in events:
            for part in event.get("content", {}).get("parts", []):
                if "text" in part and part["text"].strip():
                    parts.append(part["text"])
        return "\n".join(parts) or "(no response from economist agent)"

    except Exception as e:
        logger.error("Economist call failed: %s", e)
        return f"Economist agent error: {e}"


def _match_skill(query: str) -> str:
    """Maps query text to AgentCard skill ID for logging."""
    q = query.lower()
    if any(w in q for w in ["forecast", "arima", "predict spend"]):
        return "bqml_forecast"
    if any(w in q for w in ["cluster", "segment", "k-means", "kmeans"]):
        return "bqml_cluster"
    if any(w in q for w in ["anomaly", "unusual", "spike", "outlier"]):
        return "anomaly"
    if any(w in q for w in ["chart", "plot", "visuali", "graph"]):
        return "charts"
    if any(w in q for w in ["cpa", "efficiency", "pacing"]):
        return "channel_efficiency"
    return "nl2sql"


# ══════════════════════════════════════════════════════════════════════════════
# CALLBACKS — ALL 6
# ══════════════════════════════════════════════════════════════════════════════

def _detect_client(text: str) -> Optional[str]:
    """Detect client from user text."""
    if not text:
        return None
    t = text.lower()
    if "npi" in t or "nassau" in t or "paradise island" in t:
        return "NPI"
    if "venetian" in t:
        return "Venetian"
    if "winndixie" in t or "winn dixie" in t or "winn-dixie" in t or "seg" in t:
        return "WinnDixie"
    return None


def before_agent_callback(callback_context: CallbackContext) -> Optional[types.Content]:
    """Session setup, client lock, turn tracking."""
    state = callback_context.state

    # ── Initialize session on first turn ──
    if "session_start_time" not in state:
        state["session_start_time"] = time.time()
        state["turn_count"]         = 0
        state["session_id"]         = os.getenv("SESSION_ID", f"session_{int(time.time())}")
        state["user_id"]            = os.getenv("USER_ID", "user")
        state["client_id"]          = os.getenv("DEFAULT_CLIENT_ID", "NPI")
        state["client_lock"]        = None

    state["turn_count"]      = state.get("turn_count", 0) + 1
    state["turn_start_time"] = time.time()

    # ── Extract user text ──
    user_text = ""
    try:
        session = callback_context._invocation_context.session
        for event in reversed(session.events):
            if event.author == "user" and event.content:
                for p in event.content.parts or []:
                    if getattr(p, "text", None):
                        user_text = p.text
                        break
                if user_text:
                    break
    except Exception:
        pass

    # ── Client detection + locking (same as data_science agent) ──
    detected = _detect_client(user_text)
    locked   = state.get("client_lock") or state.get("LOCKED_CLIENT")

    if locked:
        # Already locked — check for cross-client attempt
        if detected and detected != locked:
            logger.warning("🚫 Cross-client attempt: %s while locked to %s", detected, locked)
            state["_cross_client_blocked"] = detected
        # Enforce locked client
        state["client_id"] = locked
    elif detected:
        # Lock to detected client
        state["client_lock"]    = detected
        state["LOCKED_CLIENT"]  = detected
        state["client_id"]      = detected
        logger.info("🔒 Orchestrator session LOCKED to client: %s", detected)
    else:
        # No client detected — keep default but flag it
        if "client_lock" not in state or not state["client_lock"]:
            state["client_id"] = os.getenv("DEFAULT_CLIENT_ID", "NPI")
            logger.info("⚠️ No client detected — defaulting to NPI")

    # Validate client
    if state["client_id"] not in VALID_CLIENTS:
        logger.warning("Invalid client_id '%s' — resetting to NPI", state["client_id"])
        state["client_id"] = "NPI"

    logger.info(
        "▶ before_agent | client=%s | locked=%s | session=%s | turn=%d | mode=%s",
        state["client_id"], state.get("client_lock"), state["session_id"],
        state["turn_count"],
        "remote" if DATA_SCIENTIST_CARD.is_remote else "local-AgentTool",
    )
    return None


def after_agent_callback(callback_context: CallbackContext) -> Optional[types.Content]:
    """Turn logging, RLHF tagging, counter reset."""
    state    = callback_context.state
    duration = time.time() - state.get("turn_start_time", time.time())

    logger.info(
        "◀ after_agent  | client=%s | turn=%d | duration=%.2fs | tools_called=%d",
        state.get("client_id", "unknown"), state.get("turn_count", 0),
        duration, state.get("tools_called_this_turn", 0),
    )

    state["last_exchange"] = {
        "query":      state.get("last_ds_query",    ""),
        "response":   state.get("last_ds_response", ""),
        "client_id":  state.get("client_id",        ""),
        "session_id": state.get("session_id",       ""),
        "turn":       state.get("turn_count",        0),
        "duration_s": round(duration, 2),
        "skill":      _match_skill(state.get("last_ds_query", "")),
    }
    state["tools_called_this_turn"] = 0
    return None


def before_tool_callback(
    tool: BaseTool, args: dict[str, Any], tool_context: ToolContext,
) -> Optional[dict]:
    """Skill logging, guardrails, deduplication."""
    state     = tool_context.state
    client_id = state.get("client_id", "NPI")
    query     = args.get("query", args.get("pm_request", args.get("persona_request", "")))

    state["tools_called_this_turn"] = state.get("tools_called_this_turn", 0) + 1
    skill = _match_skill(query)

    logger.info(
        "⚙ before_tool  | tool=%s | skill=%s | client=%s | query=%s…",
        tool.name, skill, client_id, str(query)[:50],
    )

    if client_id not in VALID_CLIENTS:
        return {"error": f"Invalid client '{client_id}'. Valid: {sorted(VALID_CLIENTS)}."}

    # Cross-client guardrail
    query_lower = str(query).lower()
    for other in [c.lower() for c in VALID_CLIENTS if c.lower() != client_id.lower()]:
        if other in query_lower:
            logger.warning("Cross-client ref detected: '%s' in query for '%s'", other, client_id)

    state["current_skill"] = skill

    # RULE: persona_aggregator can only be called AFTER data_scientist
    if tool.name == "call_persona_aggregator":
        if not state.get("tool_result_this_turn") and not state.get("last_ds_response"):
            logger.warning("PA called before DS — enforcing pipeline rule")
            return {
                "error": (
                    "Pipeline rule: call_data_scientist must be called first "
                    "to get campaign data before persona analysis. "
                    "Please call call_data_scientist first."
                )
            }
        # DS result is available in orchestrator state as last_ds_response
        # The orchestrator LLM is responsible for passing it to PA via the query
        # Do NOT inject here — let orchestrator prompt handle the context passing
        logger.info("PA call allowed — DS result available in state for orchestrator to pass")

    # Dedup — only for data scientist calls
    if tool.name == "call_data_scientist":
        last_q = state.get("last_tool_query", "")
        curr_q = args.get("query", "")
        if curr_q and curr_q == last_q:
            logger.warning("Duplicate DS call — skipping: %s…", curr_q[:60])
            return {"result": state.get("last_ds_response", "Already processed.")}
        state["last_tool_query"] = curr_q

    return None


def after_tool_callback(
    tool: BaseTool, args: dict[str, Any],
    tool_context: ToolContext, tool_response: Any,
) -> Optional[Any]:
    """Error detection, response caching, cross-client scan."""
    state    = tool_context.state
    response = str(tool_response) if tool_response else ""
    skill    = state.get("current_skill", "unknown")

    is_error = any(m in response for m in [
        "**Connection Error:**", "**Timeout:**", "**Agent Error", "**Unexpected Error"
    ])

    logger.info(
        "✓ after_tool   | tool=%s | skill=%s | len=%d | error=%s",
        tool.name, skill, len(response), is_error,
    )

    if is_error:
        logger.error("Tool '%s' error: %s", tool.name, response[:200])
        state.setdefault("error_log", []).append({
            "tool": tool.name, "skill": skill,
            "error": response[:200], "turn": state.get("turn_count", 0),
        })

    if tool.name == "call_data_scientist" and not is_error:
        state["last_skill_used"]       = skill
        state["tool_result_this_turn"] = True

    # Detect hallucination markers in any tool response
    halluc_markers = [
        "approximately based on industry",
        "typically for clients",
        "industry average",
        "extrapolating from",
        "in most cases",
        "industry standard",
        "for illustration purposes",
        "as a general rule",
    ]
    response_lower = response.lower()
    triggered = [m for m in halluc_markers if m in response_lower]
    if triggered:
        logger.warning(
            "⚠️ Hallucination markers in %s: %s",
            tool.name, triggered
        )
        state.setdefault("hallucination_warnings", []).append({
            "tool": tool.name,
            "turn": state.get("turn_count", 0),
            "markers": triggered,
            "preview": response[:200]
        })

    return None


def before_model_callback(
    callback_context: CallbackContext, llm_request: Any,
) -> Optional[Any]:
    """Context injection, token budget logging."""
    state = callback_context.state
    logger.info(
        "⚡ before_model | client=%s | turn=%d | last_skill=%s",
        state.get("client_id", "unknown"), state.get("turn_count", 0),
        state.get("last_skill_used", "none"),
    )
    if state.get("turn_count", 0) == 1:
        state["agent_card_skills_injected"] = True
    return None


def after_model_callback(
    callback_context: CallbackContext, llm_response: Any,
) -> Optional[Any]:
    """Token usage logging, SQL generation violation check."""
    state = callback_context.state
    try:
        usage     = llm_response.usage_metadata
        in_tok    = getattr(usage, "prompt_token_count",     0)
        out_tok   = getattr(usage, "candidates_token_count", 0)
        total_tok = getattr(usage, "total_token_count",      in_tok + out_tok)
        logger.info("🔢 after_model  | tokens in=%d out=%d total=%d", in_tok, out_tok, total_tok)
        state["session_tokens_in"]  = state.get("session_tokens_in",  0) + in_tok
        state["session_tokens_out"] = state.get("session_tokens_out", 0) + out_tok
    except Exception:
        pass

    try:
        text = ""
        for candidate in (llm_response.candidates or []):
            for part in (candidate.content.parts or []):
                if hasattr(part, "text"):
                    text += part.text or ""
        if "SELECT" in text and "FROM" in text and "call_data_scientist" not in text:
            logger.warning("Orchestrator generated SQL directly — violation. Turn=%d",
                           state.get("turn_count", 0))
    except Exception:
        pass

    return None


# ══════════════════════════════════════════════════════════════════════════════
# ROOT AGENT
# VertexAiCodeExecutor on the orchestrator root agent ensures charts generated
# by sub-agents via Code Interpreter surface as inline_data in the top-level
# session that the ADK web UI is watching.
# ══════════════════════════════════════════════════════════════════════════════

root_agent = LlmAgent(
    model       = os.getenv("ROOT_AGENT_MODEL", "gemini-2.5-flash"),
    name        = "astrobot_orchestrator",
    instruction = return_instructions_orchestrator(),
    tools       = [
        call_data_scientist,      # SQL, charts, BQML, forecasting, clustering
        call_project_manager,     # Tasks, emails, projects (§4.2 strictest isolation)
        call_persona_aggregator,  # Persona analysis (§3 Global Def, Local Exec)
        call_economist,           # Macroeconomic context, FRED, BLS, NOAA, CPI
        submit_feedback,          # Thumbs up/down RLHF feedback
    ],
    # ── VertexAiCodeExecutor — enables inline chart rendering ─────────────────
    code_executor = VertexAiCodeExecutor(
        resource_name      = _CODE_INTERPRETER,
        optimize_data_file = True,
        stateful           = True,
    ),

    # ── All 6 ADK callbacks ───────────────────────────────────────────────────
    before_agent_callback = before_agent_callback,
    after_agent_callback  = after_agent_callback,
    before_tool_callback  = before_tool_callback,
    after_tool_callback   = after_tool_callback,
    before_model_callback = before_model_